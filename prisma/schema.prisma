// Prisma schema. The domain entities in src/api/domain/entities are
// deliberately independent of Prisma and are not regenerated from this file.
//
// No column has a DB-level @default (not even the id) and none uses
// @updatedAt — every value, including ids and timestamps, is set explicitly
// by the domain entities (see src/shared/core/uuid.ts and each
// entity's create()/fromPersistence()) and passed through as-is by the
// *RepositoryImpl classes. The database never invents a value on its own.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScmProvider {
  github
}

enum LlmProvider {
  gemini
  claude
  openai
}

enum CredentialType {
  llm
  scm
  action_token
  webhook_secret
}

enum CredentialProvider {
  gemini
  claude
  openai
  github
}

enum Trigger {
  action
  webhook
}

enum ReviewRunStatus {
  queued
  processing
  completed
  failed
}

enum TurnSource {
  agent
  human
  mixed
}

enum Severity {
  low
  medium
  high
  critical
}

enum CommentStatus {
  generated
  published
  discarded
  outdated
}

enum CommentKind {
  actionable
  observation
}

enum ApplyStatus {
  pending
  applied_button
  applied_manual
  not_applied
  superseded
  dismissed
}

enum CommentReplyStatus {
  queued
  processing
  completed
  failed
}

enum CommentReplyCategory {
  fix
  clarification
  disagreement
  acknowledgment
  other
}

model User {
  id           String   @id @db.VarChar(36) // UUID v4 — fixed format, see shared/core/uuid.ts
  email        String   @unique @db.VarChar(255) // RFC 5321 practical max
  passwordHash String   @db.VarChar(100) // bcrypt output is always 60 chars — headroom for a future algorithm change
  createdAt    DateTime

  repos   Repo[]
  prompts Prompt[]

  @@map("users")
}

model Repo {
  id          String      @id @db.VarChar(36)
  userId      String      @db.VarChar(36)
  scmProvider ScmProvider
  fullName    String      @db.VarChar(255) // GitHub "owner/repo" (39 + 100 char limits, generous margin)
  active      Boolean
  createdAt   DateTime
  updatedAt   DateTime

  user        User         @relation(fields: [userId], references: [id])
  config      RepoConfig?
  credentials Credential[]
  reviewRuns  ReviewRun[]

  @@map("repos")
}

model RepoConfig {
  id                String      @id @db.VarChar(36)
  repoId            String      @unique @db.VarChar(36)
  llmProvider       LlmProvider
  model             String      @db.VarChar(100) // e.g. "gemini-2.5-flash"
  tokenLimit        Int
  temperature       Float
  enabledCategories Json
  promptId          String?     @db.VarChar(36)
  reviewLanguage    String?     @db.VarChar(10)
  createdAt         DateTime
  updatedAt         DateTime

  repo   Repo    @relation(fields: [repoId], references: [id])
  prompt Prompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@map("repo_configs")
}

model Prompt {
  id        String   @id @db.VarChar(36)
  userId    String   @db.VarChar(36)
  name      String   @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime
  updatedAt DateTime

  user        User         @relation(fields: [userId], references: [id])
  repoConfigs RepoConfig[]

  @@unique([userId, name])
  @@map("prompts")
}

model Credential {
  id              String             @id @db.VarChar(36)
  repoId          String             @db.VarChar(36)
  type            CredentialType
  provider        CredentialProvider
  // base64(iv[12] + authTag[16] + ciphertext) — generous bound around any
  // realistic API key/PAT length, not a tight fit around today's providers.
  encryptedSecret String?            @db.VarChar(1000)
  secretHash      String?            @db.VarChar(64) // SHA-256 hex digest — fixed format, see shared/infra/crypto/hashing.ts
  scopes          String?            @db.VarChar(255) // reserved, not populated yet
  lastValidatedAt DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  repo Repo @relation(fields: [repoId], references: [id])

  @@unique([repoId, type], name: "repoId_type")
  @@index([secretHash])
  @@map("credentials")
}

model ReviewRun {
  id                   String          @id @db.VarChar(36)
  repoId               String          @db.VarChar(36)
  prNumber             Int
  commitSha            String          @db.VarChar(40) // git SHA-1 hex — fixed length while GitHub stays on SHA-1
  trigger              Trigger
  status               ReviewRunStatus
  // Free-form message from our own code or a provider's own error body —
  // deliberately left unbounded (no @db.VarChar): a length limit here risks
  // failing the exact insert meant to record why something else failed.
  errorReason          String?
  totalInputTokens     Int
  totalOutputTokens    Int
  totalReasoningTokens Int
  llmProvider          LlmProvider?
  model                String?
  estimatedCost        Decimal?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime

  repo     Repo         @relation(fields: [repoId], references: [id])
  turns    ReviewTurn[]
  comments Comment[]

  @@unique([repoId, commitSha], name: "repoId_commitSha")
  @@map("review_runs")
}

model ReviewTurn {
  id              String     @id @db.VarChar(36)
  reviewRunId     String     @db.VarChar(36)
  index           Int
  inputTokens     Int
  outputTokens    Int
  reasoningTokens Int
  source          TurnSource
  // Same reasoning as ReviewRun.errorReason — left unbounded on purpose.
  errorReason     String?
  createdAt       DateTime

  reviewRun ReviewRun @relation(fields: [reviewRunId], references: [id])
  comments  Comment[]

  @@map("review_turns")
}

model Comment {
  id              String        @id @db.VarChar(36)
  reviewRunId     String        @db.VarChar(36)
  reviewTurnId    String        @db.VarChar(36)
  file            String        @db.VarChar(1024) // repo-relative path — generous for deep monorepo paths
  // `line` is the FIRST line of the suggestion's range — our own
  // convention, deliberately the opposite of GitHub's REST API (where
  // `line` means the LAST line and `start_line` the first). Never send
  // these two straight through to GithubScmAdapter without checking which
  // is which.
  line            Int
  // Nullable only so a historical row (created before this field existed)
  // reads as null in the DB — the entity always resolves it to `line` in
  // that case (see Comment.fromPersistence), so every Comment in memory has
  // a real endLine. `endLine === line` means a single-line suggestion (or
  // an observation, where both are just the flagged line).
  endLine         Int?
  category        String        @db.VarChar(100)
  severity        Severity
  // LLM-generated review text — no natural bound, left unbounded on purpose
  // (same reasoning as the errorReason fields above).
  body            String
  status          CommentStatus
  externalId      String?       @db.VarChar(50) // GitHub's own comment id (numeric, stringified)
  kind            CommentKind
  // The text that would replace the target line(s) — always null when kind
  // is "observation". No natural bound, same reasoning as body.
  suggestedCode   String?
  // The diff line immediately before/after `line`, captured at generation
  // time — lets reconciliation relocate the suggestion if unrelated edits
  // shift the file between the commit it was published on and the commit
  // being reconciled, instead of blindly trusting a now-stale line number.
  // Null whenever no such neighbor existed in the diff hunk (edge of file,
  // edge of hunk) or for comments created before this field existed —
  // reconciliation falls back to the old direct-line read in that case.
  contextBefore   String?
  contextAfter    String?
  // All four below are always null when kind is "observation" — there is no
  // "apply status" for something that isn't a suggestion.
  applyStatus     ApplyStatus?
  appliedAt       DateTime?
  appliedAtCommit String?       @db.VarChar(40) // git SHA-1 hex, same bound as ReviewRun.commitSha
  detectionMethod String?       @db.VarChar(100)
  // Attributed/estimated cost, split from the ReviewTurn's total (see
  // attribute-comment-cost.ts) — never the comment's "true" individual
  // cost, since the LLM bills the whole turn as one call.
  inputTokens     Int
  outputTokens    Int
  reasoningTokens Int
  estimatedCost   Decimal?
  createdAt       DateTime

  reviewRun   ReviewRun           @relation(fields: [reviewRunId], references: [id])
  reviewTurn  ReviewTurn          @relation(fields: [reviewTurnId], references: [id])
  applyEvents CommentApplyEvent[]
  replies     CommentReply[]

  @@index([reviewRunId, file, line])
  @@map("comments")
}

model CommentApplyEvent {
  id              String      @id @db.VarChar(36)
  commentId       String      @db.VarChar(36)
  newStatus       ApplyStatus
  commitSha       String?     @db.VarChar(40)
  detectionMethod String      @db.VarChar(100)
  createdAt       DateTime

  comment Comment @relation(fields: [commentId], references: [id])

  @@map("comment_apply_events")
}

model CommentReply {
  id                 String                @id @db.VarChar(36)
  commentId          String                @db.VarChar(36)
  // GitHub's id for the HUMAN comment that triggered this reply - not
  // Comment.externalId (which is the Bella comment this thread is about).
  // Unique: this is both the idempotency guard against webhook redelivery
  // and (together with other logic elsewhere) part of the loop-prevention
  // defense.
  humanExternalId    String                @unique @db.VarChar(50)
  humanBody          String
  humanAuthor        String                @db.VarChar(255)
  status             CommentReplyStatus
  category           CommentReplyCategory?
  errorReason        String?
  bellaBody          String?
  bellaSuggestedCode String?
  // Unique: each row ever publishes at most one Bella reply, and GitHub
  // comment ids are globally unique — so this is a real data-integrity
  // guarantee, not just an index. Also the index findByBellaExternalId
  // needs, now that it runs on every incoming comment event (loop
  // prevention) rather than an occasional lookup.
  bellaExternalId    String?               @unique @db.VarChar(50)
  inputTokens        Int
  outputTokens       Int
  reasoningTokens    Int
  llmProvider        LlmProvider?
  model              String?
  estimatedCost      Decimal?
  createdAt          DateTime
  completedAt        DateTime?

  comment Comment @relation(fields: [commentId], references: [id])

  @@map("comment_replies")
}
