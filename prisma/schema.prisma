// Prisma schema. The domain entities in src/api/domain/entities are
// deliberately independent of Prisma and are not regenerated from this file.
//
// No column has a DB-level @default (not even the id) and none uses
// @updatedAt — every value, including ids and timestamps, is set explicitly
// by the domain entities (see src/shared/core/uuid.ts and each
// entity's create()/fromPersistence()) and passed through as-is by the
// *RepositoryImpl classes. The database never invents a value on its own.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScmProvider {
  github
}

enum LlmProvider {
  gemini
}

enum CredentialType {
  llm
  scm
  action_token
  webhook_secret
}

enum CredentialProvider {
  gemini
  github
}

enum Trigger {
  action
  webhook
}

enum ReviewRunStatus {
  queued
  processing
  completed
  failed
}

enum TurnSource {
  agent
  human
  mixed
}

enum Severity {
  low
  medium
  high
  critical
}

enum CommentStatus {
  generated
  published
  discarded
  outdated
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime

  repos Repo[]

  @@map("users")
}

model Repo {
  id          String      @id
  userId      String
  scmProvider ScmProvider
  fullName    String
  active      Boolean
  createdAt   DateTime
  updatedAt   DateTime

  user        User         @relation(fields: [userId], references: [id])
  config      RepoConfig?
  credentials Credential[]
  reviewRuns  ReviewRun[]

  @@map("repos")
}

model RepoConfig {
  id                String      @id
  repoId            String      @unique
  llmProvider       LlmProvider
  model             String
  tokenLimit        Int
  temperature       Float
  enabledCategories Json
  createdAt         DateTime
  updatedAt         DateTime

  repo Repo @relation(fields: [repoId], references: [id])

  @@map("repo_configs")
}

model Credential {
  id              String             @id
  repoId          String
  type            CredentialType
  provider        CredentialProvider
  encryptedSecret String?
  secretHash      String?
  scopes          String?
  lastValidatedAt DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  repo Repo @relation(fields: [repoId], references: [id])

  @@unique([repoId, type], name: "repoId_type")
  @@index([secretHash])
  @@map("credentials")
}

model ReviewRun {
  id                   String          @id
  repoId               String
  prNumber             Int
  commitSha            String
  trigger              Trigger
  status               ReviewRunStatus
  errorReason          String?
  totalInputTokens     Int
  totalOutputTokens    Int
  totalReasoningTokens Int
  estimatedCost        Decimal?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime

  repo     Repo         @relation(fields: [repoId], references: [id])
  turns    ReviewTurn[]
  comments Comment[]

  @@unique([repoId, commitSha], name: "repoId_commitSha")
  @@map("review_runs")
}

model ReviewTurn {
  id              String     @id
  reviewRunId     String
  index           Int
  inputTokens     Int
  outputTokens    Int
  reasoningTokens Int
  source          TurnSource
  errorReason     String?
  createdAt       DateTime

  reviewRun ReviewRun @relation(fields: [reviewRunId], references: [id])
  comments  Comment[]

  @@map("review_turns")
}

model Comment {
  id           String        @id
  reviewRunId  String
  reviewTurnId String
  file         String
  line         Int
  category     String
  severity     Severity
  body         String
  status       CommentStatus
  externalId   String?
  createdAt    DateTime

  reviewRun  ReviewRun  @relation(fields: [reviewRunId], references: [id])
  reviewTurn ReviewTurn @relation(fields: [reviewTurnId], references: [id])

  @@index([reviewRunId, file, line])
  @@map("comments")
}
