// Prisma schema — minimal initialization.
//
// The models (User, Repo, RepoConfig, Credential, ReviewRun, ReviewTurn,
// Comment) will be mapped in as each corresponding PRD is implemented. The
// full reference for fields, types, and relationships lives in
// ../../backend-prds/00-shared-modelo-de-dados.md — use that document as
// the source of truth when adding models here, not the domain entities in
// src/api/domain/entities (which are deliberately independent of Prisma).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
