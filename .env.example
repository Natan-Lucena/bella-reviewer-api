# Copy to .env and fill in real values. Never commit the actual .env file.

NODE_ENV=development
PORT=3000

# Local Postgres via docker-compose (see docker-compose.yml)
DATABASE_URL="postgresql://bella:bella@localhost:5432/bella_reviewer?schema=public"

# Master key for symmetric encryption (AES-256-GCM) of dynamic credentials
# (Credential.encryptedSecret). Must be 32 bytes.
# Generate locally with: openssl rand -base64 32
MASTER_KEY=

# User session signing key (JWT). Generate locally with: openssl rand -base64 32
SESSION_SECRET=

# Frontend origin, for CORS configuration (frontend and backend are
# different origins, so the session cookie needs this to be set correctly).
FRONTEND_ORIGIN=http://localhost:3001

# This backend's own public URL, shown to the user as the webhook target
# when they generate a webhook secret, and used as the callback address for
# queued review processing. In production this must be a reachable address,
# not localhost.
BACKEND_PUBLIC_URL=http://localhost:3000

# Upstash QStash — async queue for review processing. Get a token at
# https://console.upstash.com/qstash. QSTASH_URL rarely needs overriding.
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io

# Shared secret the internal /internal/review-runs/:id/process callback
# expects, forwarded through QStash on publish. Generate locally with:
# openssl rand -base64 32
INTERNAL_PROCESS_API_KEY=

# Defaults applied to a new Repo's RepoConfig on creation. Optional — both
# have sensible defaults (see src/config.ts).
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_TOKEN_LIMIT=100000
