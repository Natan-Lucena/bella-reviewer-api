# Copie para .env e preencha os valores reais. Nunca commitar o .env real.

NODE_ENV=development
PORT=3000

# Postgres local via docker-compose (ver docker-compose.yml)
DATABASE_URL="postgresql://bella:bella@localhost:5432/bella_reviewer?schema=public"

# Chave mestra de cifra simétrica (AES-256-GCM) das credenciais dinâmicas
# (Credencial.segredo_cifrado — ver backend-prds/01-shared-cifra-hash-credenciais.md).
# Deve ter 32 bytes. Gerar localmente com: openssl rand -base64 32
MASTER_KEY=

# Chave de assinatura da sessão de usuário (JWT — ver backend-prds/02-auth-cadastro-login-sessao.md).
# Gerar localmente com: openssl rand -base64 32
SESSION_SECRET=

# Origem do frontend, para configuração de CORS (ver refinamento.md — client-side fetch cross-origin).
FRONTEND_ORIGIN=http://localhost:3001
