{
  "name": "bella-reviewer-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend da plataforma de code review assistido por IA (TCC UFC Quixadá). Especificações de implementação em ../backend-prds/.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"**/*.integration.spec.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.spec.ts\"",
    "test:coverage": "vitest run --coverage --exclude \"**/*.integration.spec.ts\"",
    "test:integration": "vitest run --include \"**/*.integration.spec.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "vitest-mock-extended": "^5.1.0"
  }
}
